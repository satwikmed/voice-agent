# VoiceIQ Configuration

# OpenAI API key (required for live simulation & VoiceIQ EVA benchmarks)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama model to use for local runs (Agent simulator & Judge evaluator)
# Default: llama3:8b, but you can change to llama3.2:3b if that is already pulled.
OLLAMA_MODEL=llama3:8b

# Ollama API Host URL (default is http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Path to the SQLite database
DATABASE_PATH=voiceiq.db
